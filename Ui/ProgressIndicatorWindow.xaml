<Window x:Class="texAi.Ui.ProgressIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Width="34" Height="34"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
        34x34 for a 26px disc: the extra ring of transparent pixels is headroom
        for the success pulse (x1.15) and the error shake (4px each way), so
        neither is clipped by the window edge.
    -->

    <Window.Resources>

        <Storyboard x:Key="EnterStoryboard">
            <DoubleAnimation Storyboard.TargetName="Root"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.18" />
            <DoubleAnimation Storyboard.TargetName="RootScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.6" To="1" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.6" To="1" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- A Storyboard, not CompositionTarget.Rendering: the animation clock is
             owned by WPF, so it keeps time correctly while the transform blocks
             on a slow model instead of drifting with frame rate. -->
        <Storyboard x:Key="SpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ArcRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:0.9" />
        </Storyboard>

        <Storyboard x:Key="SuccessStoryboard">
            <DoubleAnimation Storyboard.TargetName="Arc"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="Check"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.05" />
            <DoubleAnimation Storyboard.TargetName="Check"
                             Storyboard.TargetProperty="StrokeDashOffset"
                             From="8.2" To="0" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX">
                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1.15" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.36" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1.15" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.36" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="Root"
                             Storyboard.TargetProperty="Opacity"
                             To="0" BeginTime="0:0:0.81" Duration="0:0:0.2" />
        </Storyboard>

        <!-- Held roughly twice as long as success. A failure is the one state
             worth actually reading, and it is easy to miss a 20px dot. -->
        <Storyboard x:Key="ErrorStoryboard">
            <DoubleAnimation Storyboard.TargetName="Arc"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.15" />
            <DoubleAnimation Storyboard.TargetName="ErrorRing"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.15" />
            <DoubleAnimation Storyboard.TargetName="Cross"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.05" />
            <DoubleAnimation Storyboard.TargetName="Cross"
                             Storyboard.TargetProperty="StrokeDashOffset"
                             From="6.5" To="0" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootShift" Storyboard.TargetProperty="X">
                <LinearDoubleKeyFrame KeyTime="0:0:0.00" Value="0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.06" Value="-4" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.13" Value="4" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.19" Value="-2.5" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="2.5" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.31" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="Root"
                             Storyboard.TargetProperty="Opacity"
                             To="0" BeginTime="0:0:1.5" Duration="0:0:0.25" />
        </Storyboard>

    </Window.Resources>

    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="RootShift" X="0" Y="0" />
            </TransformGroup>
        </Grid.RenderTransform>

        <Ellipse Width="26" Height="26" Fill="#E61F1C15" />

        <Ellipse Width="18" Height="18"
                 Stroke="{StaticResource TextPrimary}"
                 StrokeThickness="2.2"
                 Opacity="0.14" />

        <!-- Circumference is pi*18 = 56.55px, which at a 2.2px stroke is 25.7
             dash units; 7 on / 18.7 off is a 27% arc that closes the loop exactly,
             so the gap never seams as it rotates. -->
        <Ellipse x:Name="Arc" Width="18" Height="18"
                 Stroke="{StaticResource Success}"
                 StrokeThickness="2.2"
                 StrokeDashArray="7 18.7"
                 StrokeDashCap="Round"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="ArcRotate" Angle="0" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse x:Name="ErrorRing" Width="18" Height="18"
                 Stroke="{StaticResource Error}"
                 StrokeThickness="2.2"
                 Opacity="0" />

        <!-- Path length is 17.8px, so an 8.2-unit dash (18px) covers it whole;
             sliding the offset to zero draws the tick instead of popping it in. -->
        <Path x:Name="Check"
              Data="M 11.5,17.5 L 15.5,21.5 L 23,12"
              Stroke="{StaticResource Success}"
              StrokeThickness="2.2"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              StrokeLineJoin="Round"
              StrokeDashArray="8.2 8.2"
              StrokeDashOffset="8.2"
              Opacity="0" />

        <Path x:Name="Cross"
              Data="M 12.5,12.5 L 21.5,21.5 M 21.5,12.5 L 12.5,21.5"
              Stroke="{StaticResource Error}"
              StrokeThickness="2.2"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              StrokeDashArray="6.5 6.5"
              StrokeDashOffset="6.5"
              Opacity="0" />
    </Grid>
</Window>
