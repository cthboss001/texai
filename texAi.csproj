<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>texAi</RootNamespace>
    <AssemblyName>texAi</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>

    <!-- Kept in sync with installer\texai.iss MyAppVersion by hand: UpdateService
         reads this at runtime to decide whether a GitHub release is newer. -->
    <Version>2.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

  <!--
    InvariantGlobalization is deliberately absent. It was set while this was a
    WinForms app, where nothing noticed. WPF's font cache constructs a
    CultureInfo for every major language to work out which typographic features
    a face supports, and in invariant mode that throws on the first TextBlock
    that lays out, taking the process with it.
  -->

  <!--
    WinForms is still referenced, but only for NotifyIcon (WPF has no tray API)
    and Screen (for multi-monitor work areas). Its implicit usings have to go:
    with both frameworks enabled, System.Windows.Forms and System.Windows each
    define Application, Clipboard, Point, Size, Color, Control and MessageBox,
    so every file would need a disambiguating alias. The two files that want
    WinForms now say so explicitly.
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
